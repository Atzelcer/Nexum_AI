// =============================================================================
// NEXUM AI - PARTE 2: TRES MODOS
// Copiar y pegar en: https://dbdiagram.io
//
// modalidades_aplicacion
//   ├── MODO_ARQUITECTO
//   │     ├── arquitecto_contextos
//   │     ├── arquitecto_escenas
//   │     └── arquitecto_assets
//   ├── MODO_JUEGO
//   │     ├── juego_emuladores
//   │     ├── juego_catalogo
//   │     └── juego_adaptadores
//   └── MODO_COMPUTADOR
//         ├── computador_mapeo_mano
//         ├── computador_acciones_sistema
//         └── computador_contexto_escritorio
// =============================================================================

Project nexum_ai_parte_2 {
  database_type: 'PostgreSQL / MongoDB conceptual'
  Note: 'Parte 2: modalidades_aplicacion se reparte en MODO_ARQUITECTO, MODO_JUEGO y MODO_COMPUTADOR.'
}

TableGroup "FILA 1 - Cabeza" [color: #1E3A5F] {
  modalidades_aplicacion
}

TableGroup "FILA 2 - Tres modos" [color: #475569] {
  MODO_ARQUITECTO
  MODO_JUEGO
  MODO_COMPUTADOR
}

TableGroup "FILA 3" [color: #64748B] {
  arquitecto_contextos
  juego_emuladores
  computador_mapeo_mano
}

TableGroup "FILA 4" [color: #64748B] {
  arquitecto_escenas
  juego_catalogo
  computador_acciones_sistema
}

TableGroup "FILA 5" [color: #64748B] {
  arquitecto_assets
  juego_adaptadores
  computador_contexto_escritorio
}

// -----------------------------------------------------------------------------
// FILA 1
// -----------------------------------------------------------------------------

Table modalidades_aplicacion {
  codigoModalidad varchar [pk, note: 'MODO_ARQUITECTO | MODO_JUEGO | MODO_COMPUTADOR']
  nombreModalidad varchar
  descripcionModalidad varchar
  categoriasComando json
  motorDestino varchar
  gestosPermitidos json
  permiteDosManos boolean
  tiempoDebounceMs integer
  sensibilidadMovimiento real
  estadoModalidad varchar
  fechaRegistro datetime

  Note: 'Tabla raíz. Desde aquí se reparte el sistema en los tres modos.'
}

// -----------------------------------------------------------------------------
// FILA 2
// -----------------------------------------------------------------------------

Table MODO_ARQUITECTO {
  codigoModalidad varchar [pk, ref: > modalidades_aplicacion.codigoModalidad]
  tipoEspacioTrabajo varchar [note: 'lienzo_2d | tablero | maqueta_espacial']
  unidadMedida varchar [note: 'pixel | centimetro | unidad_libre']
  mostrarRejilla boolean
  magnetismoActivo boolean
  tamanoMagnetismo real
  zoomPredeterminado real
  permiteSeleccionMultiple boolean
  fechaActualizacion datetime

  Note: 'Lienzo de diseño. No está forzado a 3D.'
}

Table MODO_JUEGO {
  codigoModalidad varchar [pk, ref: > modalidades_aplicacion.codigoModalidad]
  codigoGuante varchar [note: 'FK lógica a configuracion_guante']
  permiteDescarga boolean
  latenciaMaximaMs integer
  sensibilidadMando real
  fechaActualizacion datetime

  Note: 'No crea un juego propio: carga un emulador y conecta el guante.'
}

Table MODO_COMPUTADOR {
  codigoModalidad varchar [pk, ref: > modalidades_aplicacion.codigoModalidad]
  codigoGuante varchar [note: 'FK lógica a configuracion_guante']
  codigoCamara varchar [note: 'FK lógica a configuracion_vision']
  usaVision boolean
  usaInercia boolean
  layoutTeclado varchar [note: 'qwerty | numerico | personalizado']
  velocidadPuntero real
  sensibilidadScroll real
  fechaActualizacion datetime

  Note: 'El guante y la visión controlan el computador.'
}

// -----------------------------------------------------------------------------
// FILA 3
// -----------------------------------------------------------------------------

Table arquitecto_contextos {
  codigoContexto varchar [pk]
  codigoModalidad varchar [not null, ref: > MODO_ARQUITECTO.codigoModalidad]
  nombreContexto varchar
  tipoContexto varchar [note: 'diseno | edicion | presentacion']
  dimensionTrabajo varchar [note: '2d | 2.5d | espacial']
  origenCoordenadas json
  limitesLienzo json
  fondoTrabajo json
  activo boolean
  fechaRegistro datetime
}

Table juego_emuladores {
  codigoEmulador varchar [pk]
  codigoModalidad varchar [not null, ref: > MODO_JUEGO.codigoModalidad]
  nombreEmulador varchar
  plataforma varchar [note: 'nes | snes | gba | n64 | arcade | otro']
  versionEmulador varchar
  rutaEjecutable varchar
  protocoloEntrada varchar [note: 'teclado | gamepad | api_emulador']
  estadoEmulador varchar [note: 'disponible | activo | error']
  fechaRegistro datetime
}

Table computador_mapeo_mano {
  codigoMapeo varchar [pk]
  codigoModalidad varchar [not null, ref: > MODO_COMPUTADOR.codigoModalidad]
  codigoGesto varchar [note: 'FK lógica a catalogo_gestos']
  dedoReferencia varchar [note: 'pulgar | indice | medio | anular | menique | palma']
  tipoControl varchar [note: 'puntero | clic | arrastre | teclado | atajo']
  parametrosMapeo json
  activo boolean
  fechaRegistro datetime
}

// -----------------------------------------------------------------------------
// FILA 4
// -----------------------------------------------------------------------------

Table arquitecto_escenas {
  codigoEscena varchar [pk]
  codigoContexto varchar [not null, ref: > arquitecto_contextos.codigoContexto]
  codigoSesion varchar [note: 'FK lógica a sesiones_captura']
  nombreEscena varchar
  descripcionEscena varchar
  vistaActiva json
  estadoEscena varchar [note: 'borrador | activa | archivada']
  fechaCreacion datetime
  fechaActualizacion datetime
}

Table juego_catalogo {
  codigoTitulo varchar [pk]
  codigoEmulador varchar [not null, ref: > juego_emuladores.codigoEmulador]
  nombreTitulo varchar
  plataforma varchar
  archivoRom varchar
  estadoDescarga varchar [note: 'disponible | descargando | instalado']
  anioPublicacion integer
  fechaAlta datetime
}

Table computador_acciones_sistema {
  codigoAccion varchar [pk]
  codigoMapeo varchar [not null, ref: > computador_mapeo_mano.codigoMapeo]
  codigoComando varchar [note: 'FK lógica a catalogo_comandos']
  tipoAccion varchar [note: 'raton | teclado | ventana | desplazamiento']
  teclaEquivalente varchar
  combinacionAtajo varchar
  botonRaton varchar [note: 'izquierdo | derecho | medio']
  resultadoEsperado varchar
  fechaRegistro datetime
}

// -----------------------------------------------------------------------------
// FILA 5
// -----------------------------------------------------------------------------

Table arquitecto_assets {
  codigoAsset varchar [pk]
  codigoEscena varchar [not null, ref: > arquitecto_escenas.codigoEscena]
  codigoComando varchar [note: 'FK lógica a catalogo_comandos']
  nombreAsset varchar
  tipoAsset varchar [note: 'figura | icono | forma | texto | imagen']
  geometria varchar [note: 'rectangulo | circulo | poligono | trazo | sprite']
  posicion json
  rotacion real
  escala json
  estiloVisual json
  capa integer
  seleccionado boolean
  fechaActualizacion datetime
}

Table juego_adaptadores {
  codigoAdaptador varchar [pk]
  codigoTitulo varchar [not null, ref: > juego_catalogo.codigoTitulo]
  codigoGesto varchar [note: 'FK lógica a catalogo_gestos']
  codigoComando varchar [note: 'FK lógica a catalogo_comandos']
  entradaEmulador varchar [note: 'A | B | START | SELECT | PAD_UP | PAD_DOWN | PAD_LEFT | PAD_RIGHT']
  tipoEntrada varchar [note: 'boton | eje | gatillo']
  intensidadDefault real
  activo boolean
  fechaActualizacion datetime
}

Table computador_contexto_escritorio {
  codigoContextoEscritorio varchar [pk]
  codigoAccion varchar [not null, ref: > computador_acciones_sistema.codigoAccion]
  codigoSesion varchar [note: 'FK lógica a sesiones_captura']
  aplicacionActiva varchar
  ventanaActiva varchar
  tipoSuperficie varchar [note: 'escritorio | navegador | documento | formulario']
  posicionPuntero json
  estadoFoco varchar [note: 'activo | segundo_plano | bloqueado']
  fechaActualizacion datetime
}
