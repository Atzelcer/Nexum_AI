// Diagrama ERD - Base de datos NoSQL nexum_ai v2 (MongoDB)
// 30 colecciones: 6 nucleo compartido + 8 por modalidad x 3
// Importar en https://dbdiagram.io

TableGroup nucleo_compartido [color: #1E3A5F] {
  catalogo_gestos
  modalidades_aplicacion
  configuracion_guante
  configuracion_vision
  configuracion_sistema
  modelos_entrenados
}

TableGroup modalidad_arquitecto_tridimensional [color: #2563EB] {
  arquitecto_comandos
  arquitecto_reglas_semanticas
  arquitecto_configuracion
  arquitecto_sesiones
  arquitecto_muestras
  arquitecto_historial_comandos
  arquitecto_telemetria
  arquitecto_escenas
}

TableGroup modalidad_control_videojuego [color: #DC2626] {
  videojuego_comandos
  videojuego_reglas_semanticas
  videojuego_configuracion
  videojuego_sesiones
  videojuego_muestras
  videojuego_historial_comandos
  videojuego_telemetria
  videojuego_perfil_jugador
}

TableGroup modalidad_interaccion_hibrida [color: #16A34A] {
  hibrida_comandos
  hibrida_reglas_semanticas
  hibrida_configuracion
  hibrida_sesiones
  hibrida_muestras
  hibrida_historial_comandos
  hibrida_telemetria
  hibrida_teclado_virtual
}

// ============================================================
// NUCLEO COMPARTIDO
// ============================================================

Table catalogo_gestos {
  codigoGesto varchar [pk]
  nombreGesto varchar
  tipoGesto varchar [note: 'estatico | dinamico']
  categoriaGesto varchar [note: 'manipulacion | combate | navegacion']
  descripcionGesto varchar
  dedosInvolucrados json
  requiereVision boolean
  requiereInercia boolean
  requiereFusion boolean
  duracionMinimaMs integer
  duracionMaximaMs integer
  umbralConfianza real
  ventanaTemporalMs integer
  secuenciaMovimiento json
  gestosRelacionados json
  activo boolean
  fechaRegistro datetime
}

Table modalidades_aplicacion {
  codigoModalidad varchar [pk, note: 'arquitecto_tridimensional | control_videojuego | interaccion_hibrida']
  nombreModalidad varchar
  descripcionModalidad varchar
  motorDestino varchar [note: 'threejs | unity | navegador']
  categoriasComando json
  gestosPermitidos json
  coleccionComandos varchar [note: 'arquitecto_comandos | videojuego_comandos | hibrida_comandos']
  coleccionSesiones varchar
  permiteDosManos boolean
  tiempoDebounceMs integer
  sensibilidadMovimiento real
  estadoModalidad varchar
  fechaRegistro datetime
}

Table configuracion_guante {
  codigoGuante varchar [pk]
  codigoEsp32 varchar
  codigoMultiplexor varchar
  cantidadSensores integer
  mapaSensores json
  posicionNeutral json
  rangosMovimiento json
  frecuenciaMuestreoHz integer
  tipoFiltro varchar
  protocoloComunicacion varchar
  puertoComunicacion integer
  versionFirmware varchar
  calibracionEstable boolean
  puntajeCalidad real
  calibracionActiva boolean
  fechaCalibracion datetime
  fechaRegistro datetime
}

Table configuracion_vision {
  codigoCamara varchar [pk]
  resolucionCaptura varchar
  frecuenciaCapturaFps integer
  modeloDeteccion varchar
  cantidadManosMaxima integer
  confianzaDeteccion real
  confianzaSeguimiento real
  espejoHorizontal boolean
  normalizarCoordenadas boolean
  configuracionActiva boolean
  fechaRegistro datetime
}

Table configuracion_sistema {
  codigoConfiguracion varchar [pk]
  modalidadActiva varchar [ref: > modalidades_aplicacion.codigoModalidad]
  desfaseVisionImuMs integer
  tamanoVentanaMs integer
  tamanoBuffer integer
  confianzaMinimaGlobal real
  tiempoDebounceGlobalMs integer
  frecuenciaActualizacionHudMs integer
  mostrarTelemetria boolean
  mostrarConfianza boolean
  mostrarHistorial boolean
  ttlTelemetriaDias integer
  rutaArchivos varchar
  configuracionActiva boolean
  fechaActualizacion datetime
}

Table modelos_entrenados {
  codigoModelo varchar [pk]
  codigoModalidad varchar [ref: > modalidades_aplicacion.codigoModalidad]
  nombreModelo varchar
  tipoModelo varchar [note: 'clasificador | lstm | gru']
  versionModelo varchar
  precisionModelo real
  gestosEntrenados json
  estadoModelo varchar [note: 'entrenando | listo | archivado']
  modeloActivo boolean
  rutaArchivo varchar
  fechaEntrenamiento datetime
  fechaRegistro datetime
}

// ============================================================
// MODALIDAD 1: ARQUITECTO TRIDIMENSIONAL (Three.js)
// Gestos: pinza, rotar_muneca, palma_abierta
// Comandos: seleccionar, transformar, confirmar, cancelar
// ============================================================

Table arquitecto_comandos {
  codigoComando varchar [pk]
  nombreComando varchar
  categoriaComando varchar [note: 'manipulacion | navegacion']
  descripcionComando varchar
  tipoComando varchar [note: 'accion | transformacion | navegacion']
  gestosSugeridos json
  requiereObjetivoSeleccionado boolean
  ejesPermitidos json [note: 'x | y | z']
  parametrosComando json
  activo boolean
  fechaRegistro datetime
}

Table arquitecto_reglas_semanticas {
  codigoRegla varchar [pk]
  codigoGesto varchar [ref: > catalogo_gestos.codigoGesto]
  codigoComando varchar [ref: > arquitecto_comandos.codigoComando]
  prioridadRegla integer
  confianzaMinima real
  estadoAplicacion varchar [note: 'edicion | navegacion | vista_previa']
  ejeTransformacion varchar
  parametrosEjecucion json
  activo boolean
  fechaRegistro datetime
}

Table arquitecto_configuracion {
  codigoConfiguracion varchar [pk]
  motorDestino varchar [note: 'threejs']
  gridVisible boolean
  unidadMedida varchar
  modoCamara varchar [note: 'orbita | primera_persona | ortografica']
  snapActivado boolean
  sensibilidadRotacion real
  sensibilidadZoom real
  permiteDosManos boolean
  tiempoDebounceMs integer
  configuracionActiva boolean
  fechaRegistro datetime
}

Table arquitecto_sesiones {
  codigoSesion varchar [pk]
  codigoGuante varchar [ref: > configuracion_guante.codigoGuante]
  codigoCamara varchar [ref: > configuracion_vision.codigoCamara]
  codigoConfiguracion varchar [ref: > arquitecto_configuracion.codigoConfiguracion]
  codigoModeloClasificador varchar [ref: > modelos_entrenados.codigoModelo, null]
  fechaInicio datetime
  fechaFin datetime
  estadoSesion varchar [note: 'activa | finalizada | error']
  objetosSeleccionados json
  fechaRegistro datetime
}

Table arquitecto_muestras {
  codigoMuestra varchar [pk]
  codigoSesion varchar [ref: > arquitecto_sesiones.codigoSesion]
  codigoGesto varchar [ref: > catalogo_gestos.codigoGesto]
  fechaCaptura datetime
  datosVision json
  datosInercia json
  confianzaVision real
  confianzaInercia real
  confianzaFusion real
  etiquetaValidada boolean
}

Table arquitecto_historial_comandos {
  codigoHistorial varchar [pk]
  codigoSesion varchar [ref: > arquitecto_sesiones.codigoSesion]
  codigoGestoDetectado varchar [ref: > catalogo_gestos.codigoGesto]
  codigoComando varchar [ref: > arquitecto_comandos.codigoComando]
  fechaEjecucion datetime
  confianzaDeteccion real
  codigoObjetivoAfectado varchar
  parametrosEjecutados json
  resultadoEjecucion varchar
}

Table arquitecto_telemetria {
  codigoTelemetria varchar [pk]
  codigoSesion varchar [ref: > arquitecto_sesiones.codigoSesion]
  tipoTelemetria varchar [note: 'vision | inercia | fusion | render']
  fechaEvento datetime
  fechaExpiracion datetime [note: 'TTL index']
  latenciaMs real
  payload json
}

Table arquitecto_escenas {
  codigoEscena varchar [pk]
  codigoSesion varchar [ref: > arquitecto_sesiones.codigoSesion]
  nombreEscena varchar
  objetosEscena json
  camaraActiva json
  estadoEscena varchar [note: 'borrador | activa | archivada']
  fechaActualizacion datetime
}

// ============================================================
// MODALIDAD 2: CONTROL VIDEOJUEGO (Unity)
// Gestos: pinza, punio, golpe, deslizar
// Comandos: activar_accion, atacar, defender, saltar, habilidad, combo
// ============================================================

Table videojuego_comandos {
  codigoComando varchar [pk]
  nombreComando varchar
  categoriaComando varchar [note: 'combate | navegacion']
  descripcionComando varchar
  tipoAccion varchar [note: 'accion | ataque | defensa | movimiento | habilidad']
  gestosSugeridos json
  magnitudDefault real
  cooldownMs integer
  slotHabilidad integer
  parametrosComando json
  activo boolean
  fechaRegistro datetime
}

Table videojuego_reglas_semanticas {
  codigoRegla varchar [pk]
  codigoGesto varchar [ref: > catalogo_gestos.codigoGesto]
  codigoComando varchar [ref: > videojuego_comandos.codigoComando]
  prioridadRegla integer
  confianzaMinima real
  estadoAplicacion varchar [note: 'juego | menu | pausa']
  ventanaComboMs integer
  parametrosEjecucion json
  activo boolean
  fechaRegistro datetime
}

Table videojuego_configuracion {
  codigoConfiguracion varchar [pk]
  motorDestino varchar [note: 'unity']
  sensibilidadMovimiento real
  ventanaComboMs integer
  magnitudAtaqueDefault real
  mapeoBotones json
  permiteDosManos boolean
  tiempoDebounceMs integer
  configuracionActiva boolean
  fechaRegistro datetime
}

Table videojuego_sesiones {
  codigoSesion varchar [pk]
  codigoGuante varchar [ref: > configuracion_guante.codigoGuante]
  codigoCamara varchar [ref: > configuracion_vision.codigoCamara]
  codigoConfiguracion varchar [ref: > videojuego_configuracion.codigoConfiguracion]
  codigoModeloClasificador varchar [ref: > modelos_entrenados.codigoModelo, null]
  codigoPerfil varchar [ref: > videojuego_perfil_jugador.codigoPerfil, null]
  nombrePartida varchar
  fechaInicio datetime
  fechaFin datetime
  estadoSesion varchar [note: 'activa | finalizada | error']
  puntuacionSesion integer
  fechaRegistro datetime
}

Table videojuego_muestras {
  codigoMuestra varchar [pk]
  codigoSesion varchar [ref: > videojuego_sesiones.codigoSesion]
  codigoGesto varchar [ref: > catalogo_gestos.codigoGesto]
  fechaCaptura datetime
  datosVision json
  datosInercia json
  confianzaVision real
  confianzaInercia real
  confianzaFusion real
  etiquetaValidada boolean
}

Table videojuego_historial_comandos {
  codigoHistorial varchar [pk]
  codigoSesion varchar [ref: > videojuego_sesiones.codigoSesion]
  codigoGestoDetectado varchar [ref: > catalogo_gestos.codigoGesto]
  codigoComando varchar [ref: > videojuego_comandos.codigoComando]
  fechaEjecucion datetime
  confianzaDeteccion real
  magnitudEjecutada real
  esCombo boolean
  parametrosEjecutados json
  resultadoEjecucion varchar
}

Table videojuego_telemetria {
  codigoTelemetria varchar [pk]
  codigoSesion varchar [ref: > videojuego_sesiones.codigoSesion]
  tipoTelemetria varchar [note: 'vision | inercia | fusion | input_lag']
  fechaEvento datetime
  fechaExpiracion datetime [note: 'TTL index']
  latenciaMs real
  payload json
}

Table videojuego_perfil_jugador {
  codigoPerfil varchar [pk]
  codigoSesion varchar [note: 'FK logica a videojuego_sesiones']
  nombreJugador varchar
  nivelExperiencia varchar
  combosRegistrados json
  estadisticasCombate json
  fechaRegistro datetime
}

// ============================================================
// MODALIDAD 3: INTERACCION HIBRIDA (Navegador)
// Gestos: pinza, deslizar, palma_abierta
// Comandos: pulsar_tecla, escribir_desplazarse, confirmar, cancelar
// ============================================================

Table hibrida_comandos {
  codigoComando varchar [pk]
  nombreComando varchar
  categoriaComando varchar [note: 'navegacion | escritura']
  descripcionComando varchar
  tipoEntrada varchar [note: 'tecla | desplazamiento | confirmacion | cancelacion']
  gestosSugeridos json
  teclaEquivalente varchar
  modoDesplazamiento varchar [note: 'horizontal | vertical | libre']
  parametrosComando json
  activo boolean
  fechaRegistro datetime
}

Table hibrida_reglas_semanticas {
  codigoRegla varchar [pk]
  codigoGesto varchar [ref: > catalogo_gestos.codigoGesto]
  codigoComando varchar [ref: > hibrida_comandos.codigoComando]
  prioridadRegla integer
  confianzaMinima real
  estadoAplicacion varchar [note: 'navegacion | escritura | formulario']
  teclaEquivalente varchar
  parametrosEjecucion json
  activo boolean
  fechaRegistro datetime
}

Table hibrida_configuracion {
  codigoConfiguracion varchar [pk]
  motorDestino varchar [note: 'navegador']
  layoutTeclado varchar [note: 'qwerty | numerico | personalizado']
  velocidadDesplazamiento real
  sensibilidadScroll real
  teclaConfirmacion varchar
  teclaCancelacion varchar
  permiteDosManos boolean
  tiempoDebounceMs integer
  configuracionActiva boolean
  fechaRegistro datetime
}

Table hibrida_sesiones {
  codigoSesion varchar [pk]
  codigoGuante varchar [ref: > configuracion_guante.codigoGuante]
  codigoCamara varchar [ref: > configuracion_vision.codigoCamara]
  codigoConfiguracion varchar [ref: > hibrida_configuracion.codigoConfiguracion]
  codigoModeloClasificador varchar [ref: > modelos_entrenados.codigoModelo, null]
  codigoTeclado varchar [ref: > hibrida_teclado_virtual.codigoTeclado, null]
  urlAplicacion varchar
  fechaInicio datetime
  fechaFin datetime
  estadoSesion varchar [note: 'activa | finalizada | error']
  fechaRegistro datetime
}

Table hibrida_muestras {
  codigoMuestra varchar [pk]
  codigoSesion varchar [ref: > hibrida_sesiones.codigoSesion]
  codigoGesto varchar [ref: > catalogo_gestos.codigoGesto]
  fechaCaptura datetime
  datosVision json
  datosInercia json
  confianzaVision real
  confianzaInercia real
  confianzaFusion real
  etiquetaValidada boolean
}

Table hibrida_historial_comandos {
  codigoHistorial varchar [pk]
  codigoSesion varchar [ref: > hibrida_sesiones.codigoSesion]
  codigoGestoDetectado varchar [ref: > catalogo_gestos.codigoGesto]
  codigoComando varchar [ref: > hibrida_comandos.codigoComando]
  fechaEjecucion datetime
  confianzaDeteccion real
  teclaEjecutada varchar
  caracterIngresado varchar
  parametrosEjecutados json
  resultadoEjecucion varchar
}

Table hibrida_telemetria {
  codigoTelemetria varchar [pk]
  codigoSesion varchar [ref: > hibrida_sesiones.codigoSesion]
  tipoTelemetria varchar [note: 'vision | inercia | fusion | dom_event']
  fechaEvento datetime
  fechaExpiracion datetime [note: 'TTL index']
  latenciaMs real
  payload json
}

Table hibrida_teclado_virtual {
  codigoTeclado varchar [pk]
  codigoSesion varchar [note: 'FK logica a hibrida_sesiones']
  layoutTeclado varchar
  filasTeclado json
  teclaActiva varchar
  posicionCursor json
  fechaActualizacion datetime
}
